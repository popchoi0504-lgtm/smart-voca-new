# 2026-11-03 - smart-voca - 설정 예시 파일 (값은 비워 둔다. 실제 값은 .env 에만 적고 Git 에 올리지 않는다)
# 파일 위치: .env.example
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.

# --- DB (SQLite) ---
# 파일 위치. 비워 두면 data/voca.db. 서버(Docker)에서는 /data/voca.db 로 준다.
DB_PATH=

# --- 로그인 토큰 ---
# 로그인 토큰 서명 비밀값(예전 이름 JWT_SECRET 도 받는다). 비워 두면 서버가 켜질 때 무작위로 만든다.
SECRET_KEY=
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false

# --- 요금제 ---
FREE_WORD_LIMIT=250
PREMIUM_PRICE_KRW=4900
PREMIUM_PASS_DAYS=30

# --- 토스페이먼츠 테스트 키 (개발자센터에서 확인해 .env 에 직접 입력) ---
PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- AI 선생님 (이슈 #16) ---
# AI_PROVIDER: fake(가짜 답변, 키 불필요) 또는 gemini(실제 호출). 키는 .env 에만 적는다.
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TEACHER_ENABLED=true
AI_FREE_DAILY_LIMIT=10
AI_PREMIUM_DAILY_LIMIT=50
