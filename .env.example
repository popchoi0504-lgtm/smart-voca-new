# 2026-11-03 - smart-voca - 설정 예시 파일 (값은 비워 둔다. 실제 값은 .env 에만 적고 Git 에 올리지 않는다)
# 파일 위치: .env.example
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다.

# --- PostgreSQL 관리자 (DB 를 처음 만들 때만 사용) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# --- 서비스용 DB 접속 ---
DATABASE_URL=postgresql+psycopg2://사용자:비밀번호@localhost:5432/smart_voca
TEST_DATABASE_URL=postgresql+psycopg2://사용자:비밀번호@localhost:5432/smart_voca_test

# --- 로그인 토큰 ---
JWT_SECRET=
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false

# --- 요금제 ---
FREE_WORD_LIMIT=250
PREMIUM_PRICE_KRW=4900
PREMIUM_PASS_DAYS=30

# --- 토스페이먼츠 테스트 키 (개발자센터에서 확인해 .env 에 직접 입력) ---
PAYMENT_PROVIDER=toss
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
